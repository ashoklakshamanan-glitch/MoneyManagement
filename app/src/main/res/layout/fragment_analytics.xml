<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_background"
    tools:context="com.moneymanagement.spendwise.presentation.analytics.AnalyticsFragment">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/spacing_xxl">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@color/md_background"
                app:backgroundTint="@color/md_background"
                app:title="@string/analytics_title"
                app:titleTextColor="@color/md_on_surface" />
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/range_chip_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_l"
                android:paddingBottom="@dimen/spacing_xs"
                app:singleLine="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_week"
                    style="@style/Widget.SpendWise.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="@string/filter_all"
                    tools:text="Week" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_month"
                    style="@style/Widget.SpendWise.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:checked="true"
                    tools:text="Month" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_last_month"
                    style="@style/Widget.SpendWise.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    tools:text="Last Month" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_year"
                    style="@style/Widget.SpendWise.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    tools:text="Year" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_custom"
                    style="@style/Widget.SpendWise.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    tools:text="Custom" />
            </com.google.android.material.chip.ChipGroup>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/spacing_l">

                <!-- Stats grid: 2x2 + top category -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_s"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/stat_income"
                        layout="@layout/item_stat_card"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/stat_expense"
                        layout="@layout/item_stat_card"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_s"
                        android:layout_weight="1" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_s"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/stat_savings"
                        layout="@layout/item_stat_card"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/stat_avg_daily"
                        layout="@layout/item_stat_card"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_s"
                        android:layout_weight="1" />
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.SpendWise.CardView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_s">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/spacing_m">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_warning" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_s"
                            android:layout_weight="1"
                            android:text="@string/analytics_top_category"
                            android:textColor="@color/md_on_surface_variant"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/top_category_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/md_on_surface"
                            android:textStyle="bold"
                            tools:text="Food" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Pie: expenses by category -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.SpendWise.CardView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_m">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_l">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/analytics_by_category"
                            android:textAppearance="@style/TextAppearance.SpendWise.SectionHeader"
                            android:textColor="@color/md_on_surface" />

                        <com.github.mikephil.charting.charts.PieChart
                            android:id="@+id/category_pie_chart"
                            android:layout_width="match_parent"
                            android:layout_height="240dp"
                            android:layout_marginTop="@dimen/spacing_s" />

                        <TextView
                            android:id="@+id/pie_chart_empty_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:paddingVertical="@dimen/spacing_xl"
                            android:text="@string/analytics_no_data"
                            android:textColor="@color/md_on_surface_variant"
                            android:visibility="gone"
                            tools:visibility="gone" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Line: daily spending -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.SpendWise.CardView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_m">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_l">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/analytics_daily_spending"
                            android:textAppearance="@style/TextAppearance.SpendWise.SectionHeader"
                            android:textColor="@color/md_on_surface" />

                        <com.github.mikephil.charting.charts.LineChart
                            android:id="@+id/daily_line_chart"
                            android:layout_width="match_parent"
                            android:layout_height="200dp"
                            android:layout_marginTop="@dimen/spacing_s" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Bar: monthly expenses -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.SpendWise.CardView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_m">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_l">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/analytics_monthly_expenses"
                            android:textAppearance="@style/TextAppearance.SpendWise.SectionHeader"
                            android:textColor="@color/md_on_surface" />

                        <com.github.mikephil.charting.charts.BarChart
                            android:id="@+id/monthly_bar_chart"
                            android:layout_width="match_parent"
                            android:layout_height="200dp"
                            android:layout_marginTop="@dimen/spacing_s" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <ProgressBar
        android:id="@+id/loading_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"
        tools:visibility="gone" />

</FrameLayout>
