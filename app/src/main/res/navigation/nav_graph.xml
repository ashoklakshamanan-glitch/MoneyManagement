<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">
    <fragment
        android:id="@+id/splashFragment"
        android:name="com.moneymanagement.spendwise.presentation.splash.SplashFragment"
        android:label="Splash"
        tools:layout="@layout/fragment_splash">
        <action
            android:id="@+id/action_splash_to_dashboard"
            app:destination="@id/dashboardFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
    </fragment>
    <fragment
        android:id="@+id/dashboardFragment"
        android:name="com.moneymanagement.spendwise.presentation.dashboard.DashboardFragment"
        android:label="fragment_dashboard"
        tools:layout="@layout/fragment_dashboard">
        <action
            android:id="@+id/action_dashboard_to_addEditTransaction"
            app:destination="@id/addEditTransactionFragment" />
        <action
            android:id="@+id/action_dashboardFragment_to_transactionsFragment"
            app:destination="@id/transactionsFragment" />
        <action
            android:id="@+id/action_dashboardFragment_to_analyticsFragment"
            app:destination="@id/analyticsFragment" />
        <action
            android:id="@+id/action_dashboardFragment_to_budgetFragment"
            app:destination="@id/budgetFragment" />
        <action
            android:id="@+id/action_dashboardFragment_to_transactionDetailsFragment"
            app:destination="@id/transactionDetailsFragment" />
        <action
            android:id="@+id/action_dashboardFragment_to_settingsFragment"
            app:destination="@id/settingsFragment" />
    </fragment>
    <fragment
        android:id="@+id/addEditTransactionFragment"
        android:name="com.moneymanagement.spendwise.presentation.addTransaction.AddEditTransactionFragment"
        android:label="AddEditTransactionFragment"
        tools:layout="@layout/fragment_add_edit_transaction">
        <argument
            android:name="transactionId"
            android:defaultValue="-1L"
            app:argType="long" />
    </fragment>
    <fragment
        android:id="@+id/transactionsFragment"
        android:name="com.moneymanagement.spendwise.presentation.transactions.TransactionsFragment"
        android:label="fragment_transactions"
        tools:layout="@layout/fragment_transactions">
        <action
            android:id="@+id/action_transactionsFragment_to_analyticsFragment"
            app:destination="@id/analyticsFragment" />
        <action
            android:id="@+id/action_transactionsFragment_to_transactionDetailsFragment"
            app:destination="@id/transactionDetailsFragment" />
        <action
            android:id="@+id/action_transactionsFragment_to_addEditTransactionFragment"
            app:destination="@id/addEditTransactionFragment" />
    </fragment>
    <fragment
        android:id="@+id/analyticsFragment"
        android:name="com.moneymanagement.spendwise.presentation.analytics.AnalyticsFragment"
        android:label="fragment_analytics"
        tools:layout="@layout/fragment_analytics" />
    <fragment
        android:id="@+id/budgetFragment"
        android:name="com.moneymanagement.spendwise.presentation.budget.BudgetFragment"
        android:label="BudgetFragment" />


    <fragment
        android:id="@+id/categoriesFragment"
        android:name="com.moneymanagement.spendwise.presentation.categories.CategoriesFragment"
        android:label="@string/categories_title"
        tools:layout="@layout/fragment_categories" />
    <fragment
        android:id="@+id/transactionDetailsFragment"
        android:name="com.moneymanagement.spendwise.presentation.transactiondetails.TransactionDetailsFragment"
        android:label="TransactionDetailsFragment">
        <argument
            android:name="transactionId"
            app:argType="long" />
        <action
            android:id="@+id/action_transactionDetails_to_addEditTransaction"
            app:destination="@id/addEditTransactionFragment" />
    </fragment>
    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.moneymanagement.spendwise.presentation.settings.SettingsFragment"
        android:label="fragment_settings"
        tools:layout="@layout/fragment_settings">
        <action
            android:id="@+id/action_settingsFragment_to_categoriesFragment"
            app:destination="@id/categoriesFragment" />
    </fragment>

</navigation>